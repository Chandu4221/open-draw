{
  "name": "@open-draw/canvas",
  "version": "0.8.0",
  "description": "A framework-free, batteries-included visual canvas and drawing SDK",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Chandu4221/open-draw.git",
    "directory": "packages/canvas"
  },
  "homepage": "https://github.com/Chandu4221/open-draw#readme",
  "bugs": {
    "url": "https://github.com/Chandu4221/open-draw/issues"
  },
  "keywords": [
    "canvas",
    "drawing",
    "vector",
    "svg",
    "shapes",
    "diagrams",
    "whiteboard",
    "typescript"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "readme.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@open-draw/contracts": "workspace:*",
    "@open-draw/document": "workspace:*",
    "@open-draw/input": "workspace:*",
    "@open-draw/renderer-svg": "workspace:*",
    "@open-draw/shapes": "workspace:*",
    "eslint": "^10.13.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
