{
  "name": "open-draw",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prebuild": "npm run build -w @open-draw/schema",
    "build": "npm run build --workspaces --if-present",
    "pretypecheck": "npm run build -w @open-draw/schema",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspaces --if-present",
    "check:boundaries": "node scripts/check-boundaries.js",
    "check:deps": "node scripts/check-dependencies.js",
    "check:bitmap": "node scripts/check-no-bitmap.js",
    "check:zoom": "node scripts/check-isolated-zoom.js",
    "check:shapes": "node scripts/check-no-shape-branching.js",
    "check:filesize": "node scripts/check-file-sizes.js",
    "check:links": "node scripts/check-portable-links.js",
    "check:public-api": "node scripts/check-public-api.js",
    "check:perf": "playwright test packages/canvas/e2e/perf-baseline.spec.ts",
    "dev": "vite --config apps/studio/vite.config.ts apps/studio --open",
    "build:pages": "vite build --config apps/studio/vite.config.ts apps/studio",
    "preview:pages": "vite preview --config apps/studio/vite.config.ts apps/studio",
    "verify": "npm run build && npm run typecheck && npm test && npm run check:boundaries && npm run check:deps && npm run check:bitmap && npm run check:zoom && npm run check:shapes && npm run check:filesize && npm run check:links && npm run check:public-api"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
