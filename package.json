{
  "name": "open-draw-studio",
  "version": "0.9.5",
  "description": "A semantic wireframing and design studio built on the @open-draw/canvas SDK",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs packages apps",
    "lint:naming": "node scripts/lint-naming.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm lint:deps && pnpm lint:naming && pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [],
  "author": "",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "dependency-cruiser": "18.7.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
