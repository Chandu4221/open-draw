{
  "name": "open-draw",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check:boundaries": "node scripts/check-boundaries.js",
    "check:deps": "node scripts/check-dependencies.js",
    "check:bitmap": "node scripts/check-no-bitmap.js",
    "check:zoom": "node scripts/check-isolated-zoom.js",
    "check:shapes": "node scripts/check-no-shape-branching.js",
    "check:links": "node scripts/check-portable-links.js",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:boundaries && npm run check:deps && npm run check:bitmap && npm run check:zoom && npm run check:shapes && npm run check:links"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
